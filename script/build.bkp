pub fn main() -> Nil {
  [Circle(2.0), Rectangle(3.0, 4.5)]
  |> list.map(describe)
  |> string.join("\n")
  |> io.println

  let parsed_total =
    ["1", "2", "nope", "4"]
    |> list.filter_map(int.parse)
    |> int.sum

  io.println("sum of valid ints: " <> int.to_string(parsed_total))
}
